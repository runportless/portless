---
import {Image} from 'astro:assets';
import BrandMark from '../components/BrandMark.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {frameworks, primaryCallToAction, principles, problemCards, resources} from '../data/site';
import faultsImage from '../assets/product/faults.jpg';
import projectsImage from '../assets/product/projects.jpg';
import recordingsImage from '../assets/product/recordings.jpg';
import topologyAnimation from '../assets/product/topology-live.gif';
import trafficDetailImage from '../assets/product/traffic-detail.jpg';
import trafficImage from '../assets/product/traffic.jpg';

const title = 'Portless — Run it. See it. Break it. locally.';
const description = 'Run, inspect, record, mock, and break your complete application environment locally with one control plane.';
const primaryCTA = primaryCallToAction(import.meta.env.PUBLIC_EARLY_ACCESS_URL);
const githubURL = import.meta.env.PUBLIC_GITHUB_URL?.trim() || 'https://github.com/gregwhitaker/portless';
---

<SiteLayout title={title} description={description}>
  <header class="site-header">
    <a class="brand-link" href="#top"><BrandMark /></a>
    <nav aria-label="Primary navigation">
      <a href="#how-it-works">Run it</a>
      <a href="#control-plane">See it</a>
      <a href="#experiments">Break it</a>
      <a href="#demo">Demo</a>
      {githubURL && <a href={githubURL} target="_blank" rel="noreferrer">GitHub</a>}
      <a class="button button--small" href={primaryCTA.href} target={primaryCTA.external ? '_blank' : undefined} rel={primaryCTA.external ? 'noreferrer' : undefined}>{primaryCTA.label}</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__copy">
        <h1 id="hero-title">Own your entire<br /><span>local environment.</span></h1>
        <p class="hero__lede">Portless discovers your application, starts its processes and dependencies, and gives every service a stable, readable address—all from one local control plane.</p>
        <div class="hero__actions">
          <a class="button" href={primaryCTA.href} target={primaryCTA.external ? '_blank' : undefined} rel={primaryCTA.external ? 'noreferrer' : undefined}>{primaryCTA.label}</a>
        </div>
        <ul class="hero__proof" aria-label="Portless setup benefits">
          <li>No required project file</li>
          <li>No account</li>
          <li>macOS + Linux</li>
        </ul>
      </div>

      <div class="terminal" aria-label="Example Portless command output">
        <div class="terminal__bar">
          <span class="terminal__lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>~/workspace/store</span>
        </div>
        <div class="terminal__body">
          <p><span class="prompt">$</span> portless up<span class="cursor" aria-hidden="true"></span></p>
          <p class="terminal__line terminal__line--1"><span class="ok">✓</span> discovered checkout, inventory, orders</p>
          <p class="terminal__line terminal__line--2"><span class="ok">✓</span> started postgres and valkey</p>
          <p class="terminal__line terminal__line--3"><span class="ok">✓</span> store/local <span class="status">healthy · 5/5 ready</span></p>
          <p class="terminal__line terminal__line--4 endpoint">http://checkout.local.store.localhost</p>
        </div>
      </div>

      <div class="narrative" aria-label="Portless product narrative">
        <span>Run it.</span>
        <span>See it.</span>
        <span>Break it.</span>
        <strong>locally.</strong>
      </div>
    </section>

    <section class="section problem" id="problem" aria-labelledby="problem-title">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow eyebrow--danger">The problem</p>
          <h2 id="problem-title">Local development<br />gets messy fast.</h2>
        </div>
        <p>Ports collide. Services scatter across terminals. Dependencies run wherever they happen to fit. Soon the environment is harder to understand than the application.</p>
      </div>
      <div class="conflict-grid" aria-label="Examples of local port collisions">
        {problemCards.map((card) => (
          <article class:list={['conflict-card', `conflict-card--${card.tone}`]}>
            <p>{card.scope} / {card.owner}</p>
            <div><strong>{card.service}</strong><code>{card.port}</code></div>
            <small>▲ Address already in use</small>
          </article>
        ))}
      </div>
    </section>

    <section class="section solution-section" id="solution" aria-labelledby="solution-title">
      <div class="solution-heading">
        <div>
          <p class="eyebrow">The solution</p>
          <h2 id="solution-title">Every service gets<br /><span>a stable local identity.</span></h2>
        </div>
        <p>Portless keeps process and container ports private, then publishes service-scoped HTTP and TCP addresses. Orders and inventory can both default to <code>:8080</code>, while both PostgreSQL dependencies remain available on <code>:5432</code>.</p>
      </div>

      <div class="solution-proof" aria-label="Portless resolves shared HTTP and PostgreSQL ports for orders and inventory">
        <div class="solution-proof__side solution-proof__side--before">
          <header><span>Before Portless</span><strong>Same defaults. Immediate conflicts.</strong></header>
          <div><code><strong>orders</strong><b>HTTP</b><span>localhost:8080</span></code><small>conflict</small></div>
          <div><code><strong>inventory</strong><b>HTTP</b><span>localhost:8080</span></code><small>conflict</small></div>
          <div><code><strong>orders-db</strong><b>Postgres</b><span>localhost:5432</span></code><small>conflict</small></div>
          <div><code><strong>inventory-db</strong><b>Postgres</b><span>localhost:5432</span></code><small>conflict</small></div>
        </div>
        <div class="solution-proof__bridge" aria-hidden="true"><i>→</i></div>
        <div class="solution-proof__side solution-proof__side--after">
          <header><span>With Portless</span><strong>Each one gets its own identity.</strong></header>
          <div><code><strong>orders</strong>.local.store.localhost</code><small>ready</small></div>
          <div><code><strong>inventory</strong>.local.store.localhost</code><small>ready</small></div>
          <div><code><strong>orders-db</strong>.local.store.portless.test<b>:5432</b></code><small>ready</small></div>
          <div><code><strong>inventory-db</strong>.local.store.portless.test<b>:5432</b></code><small>ready</small></div>
        </div>
      </div>
    </section>

    <section class="section one-command narrative-section" id="how-it-works" aria-labelledby="command-title">
      <div class="narrative-section__number" aria-hidden="true">01</div>
      <div class="section-heading">
        <p class="eyebrow">Run it · one command</p>
        <h2 id="command-title">One command starts<br />the whole application.</h2>
        <p>From any supported service checkout, <code>portless up</code> discovers the project, starts its processes and managed dependencies, waits for readiness, and opens the local control plane.</p>
      </div>
      <div class="run-command"><span>From your service checkout</span><code><b>$</b> portless up</code><small>one command</small></div>
      <div class="command-flow">
        <article><span>01</span><h3>Discover</h3><p>Understand supported services and resources across every project checkout.</p></article>
        <i aria-hidden="true"></i>
        <article><span>02</span><h3>Start</h3><p>Launch local processes and managed dependencies in dependency order.</p></article>
        <i aria-hidden="true"></i>
        <article><span>03</span><h3>Ready</h3><p>Wait for health, publish stable endpoints, and open one local control plane.</p></article>
      </div>
    </section>

    <section class="section product-section" aria-labelledby="projects-title">
      <div class="product-copy">
        <p class="eyebrow">Projects + environments</p>
        <h2 id="projects-title">One application.<br />Many shapes.</h2>
        <p>A project can span several repositories. Each environment reuses that topology while deciding what runs from a checkout, in a container, against a remote service, or as a deterministic mock.</p>
        <ul class="check-list">
          <li>Reuse the same readable service names everywhere</li>
          <li>Keep remote targets behind explicit write policies</li>
          <li>Switch one provider without restarting its callers</li>
        </ul>
      </div>
      <div class="product-window product-window--projects">
        <Image src={projectsImage} alt="Portless environment overview for showcase local showing three ready services and one active fault" layout="full-width" widths={[640, 960, 1280]} quality="high" />
      </div>
    </section>

    <section class="section topology-section narrative-section" id="control-plane" aria-labelledby="topology-title">
      <div class="narrative-section__number" aria-hidden="true">02</div>
      <div class="section-heading section-heading--centered">
        <p class="eyebrow">See it · live topology</p>
        <h2 id="topology-title">See the system as it runs.</h2>
        <p>Watch real requests cross exact source-to-target edges, with rate and latency attached to the relationships that produced them.</p>
      </div>
      <div class="product-window product-window--hero">
        <img src={topologyAnimation.src} alt="Animated live Portless topology showing real checkout traffic flowing to inventory and orders" width={topologyAnimation.width} height={topologyAnimation.height} loading="lazy" decoding="async" />
        <div class="product-callout">
          <span>Live system map</span>
          <strong>Traffic has a direction.</strong>
          <p>Portless preserves the caller on every dependency edge.</p>
        </div>
      </div>
    </section>

    <section class="section traffic-section" aria-labelledby="traffic-title">
      <div class="traffic-intro">
        <div>
          <p class="eyebrow">See it · traffic inspector</p>
          <h2 id="traffic-title">Open the complete exchange.</h2>
        </div>
        <p>Move from a service waterfall to the exact request, timing, repeated headers, bounded body detail, response, and correlation confidence.</p>
      </div>
      <div class="traffic-tabs">
        <div class="traffic-tabs__list" role="tablist" aria-label="Traffic inspector views">
          <button type="button" role="tab" id="traffic-tab-trace" aria-controls="traffic-panel-trace" aria-selected="true" data-traffic-tab="trace">Trace waterfall</button>
          <button type="button" role="tab" id="traffic-tab-detail" aria-controls="traffic-panel-detail" aria-selected="false" tabindex="-1" data-traffic-tab="detail">Exchange detail</button>
        </div>
        <div class="product-window traffic-panel" role="tabpanel" id="traffic-panel-trace" aria-labelledby="traffic-tab-trace" data-traffic-panel="trace">
          <Image src={trafficImage} alt="Portless Traffic page with trace 88 expanded into a three-span waterfall across checkout, inventory, and orders" layout="full-width" widths={[640, 960, 1280]} quality="high" />
        </div>
        <div class="product-window traffic-panel" role="tabpanel" id="traffic-panel-detail" aria-labelledby="traffic-tab-detail" data-traffic-panel="detail" hidden>
          <Image src={trafficDetailImage} alt="Portless exchange detail showing the checkout to orders request, response, active fault, and recording" layout="full-width" widths={[640, 960, 1280]} quality="high" />
        </div>
      </div>
    </section>

    <section class="section experiments narrative-section" id="experiments" aria-labelledby="experiments-title">
      <div class="narrative-section__number" aria-hidden="true">03</div>
      <div class="section-heading section-heading--centered">
        <p class="eyebrow">Break it · reproduce the failure</p>
        <h2 id="experiments-title">Not just the happy path.</h2>
        <p>Keep the evidence, replace the dependency, or break one edge—without adding diagnostic code to the application.</p>
      </div>
      <div class="experiment-grid">
        <article class="experiment-card">
          <div class="experiment-card__image">
            <Image src={recordingsImage} alt="Portless Recordings page showing a stopped checkout debug recording with 30 captured events" layout="full-width" widths={[480, 720]} quality="high" />
          </div>
          <div class="experiment-card__copy">
            <span>Record</span><h3>Keep the evidence.</h3>
            <p>Capture a bounded workflow and retain the requests that matter, with body capture only when you opt in.</p>
          </div>
        </article>
        <article class="experiment-card experiment-card--mock">
          <div class="mock-console" aria-label="Example deterministic mock response">
            <p><span>GET</span> /inventory/coffee-mug</p>
            <div><code>200</code><strong>sold-out</strong></div>
            <pre>{`{
  "available": false,
  "reason": "mocked sold out"
}`}</pre>
          </div>
          <div class="experiment-card__copy">
            <span>Mock</span><h3>Replace one dependency.</h3>
            <p>Bind a service to a fixed local response while callers keep the same injected endpoint.</p>
          </div>
        </article>
        <article class="experiment-card">
          <div class="experiment-card__image">
            <Image src={faultsImage} alt="Portless Faults page showing an active slow orders rule and the targeted latency editor" layout="full-width" widths={[480, 720]} quality="high" />
          </div>
          <div class="experiment-card__copy">
            <span>Fault</span><h3>Break one edge.</h3>
            <p>Introduce latency, HTTP status codes, probability, or aborted connections without changing application code.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section principles-section" aria-labelledby="principles-title">
      <div class="principles-intro">
        <p class="eyebrow">locally.</p>
        <h2 id="principles-title">A control plane for your machine — not another platform to operate.</h2>
      </div>
      <div class="principles-grid">
        {principles.map((principle) => (
          <article>
            <span>{principle.index}</span>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </div>
      <div class="support-grid">
        <div>
          <span>Application discovery</span>
          <ul>{frameworks.map((framework) => <li>{framework}</li>)}</ul>
        </div>
        <div>
          <span>Managed resources</span>
          <ul>{resources.map((resource) => <li>{resource}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section compose-section" id="docker-compose" aria-labelledby="compose-title">
      <div class="compose-intro">
        <div>
          <p class="eyebrow">What about Docker Compose?</p>
          <h2 id="compose-title">Compose is container-first.<br /><span>Portless is application-first.</span></h2>
        </div>
        <p>Docker Compose is a solid way to start a stack you have already described as containers. Portless starts with what developers are changing: the application, its source checkouts, service relationships, and traffic.</p>
      </div>

      <div class="compose-comparison" aria-label="Docker Compose and Portless comparison">
        <article class="compose-card compose-card--docker">
          <header>
            <span aria-hidden="true">01</span>
            <div><h3>Docker Compose</h3><p>Container orchestration</p></div>
          </header>
          <ul>
            <li><strong>Define</strong><span>Services in a Compose file</span></li>
            <li><strong>Run</strong><span>Containerized processes and resources</span></li>
            <li><strong>Address</strong><span>Container DNS and published host ports</span></li>
            <li><strong>Inspect</strong><span>Container lifecycle and logs</span></li>
          </ul>
        </article>

        <div class="compose-divider" aria-hidden="true"><span>vs.</span></div>

        <article class="compose-card compose-card--portless">
          <header>
            <span aria-hidden="true">02</span>
            <div><h3>Portless</h3><p>Local application control plane</p></div>
          </header>
          <ul>
            <li><strong>Discover</strong><span>Services and resources across checkouts</span></li>
            <li><strong>Mix</strong><span>Local processes, managed containers, remote services, and mocks</span></li>
            <li><strong>Address</strong><span>Stable service names while runtime ports stay private</span></li>
            <li><strong>Observe</strong><span>Topology, traffic, recordings, mocks, and edge faults</span></li>
          </ul>
        </article>
      </div>

      <div class="compose-runtime-note">
        <span>Docker still fits.</span>
        <p>Portless can use Docker Engine or Podman for managed PostgreSQL, Valkey, MySQL, and NATS dependencies. The container runtime stays a runtime choice—not the shape of your application.</p>
        <code><b>portless</b><i aria-hidden="true">→</i> Docker / Podman <i aria-hidden="true">→</i> managed resources</code>
      </div>
    </section>

    <section class="section demo-section" id="demo" aria-labelledby="demo-title">
      <div class="demo-player">
        <video playsinline preload="metadata" poster="/demo/portless-live-app-poster.jpg" data-demo-video aria-label="46-second Portless product tour">
          <source src="/demo/portless-explainer.mp4" type="video/mp4" />
          <track kind="captions" src="/demo/portless-explainer.vtt" srclang="en" label="English" />
          Your browser does not support embedded video. <a href="/demo/portless-explainer.mp4">Download the demo</a>.
        </video>
        <div class="demo-controls" data-demo-controls>
          <button class="demo-control demo-control--play" type="button" data-demo-play aria-label="Play demo">▶</button>
          <input class="demo-progress" type="range" min="0" max="100" step="0.1" value="0" data-demo-progress aria-label="Seek demo" />
          <output class="demo-time" data-demo-time>0:00 / 0:46</output>
          <div class="demo-controls__secondary">
            <button class="demo-control" type="button" data-demo-captions aria-label="Turn captions on" aria-pressed="false">CC</button>
            <button class="demo-control" type="button" data-demo-mute aria-label="Mute demo" aria-pressed="false">MUTE</button>
            <button class="demo-control" type="button" data-demo-fullscreen aria-label="Enter full screen">FULL</button>
          </div>
        </div>
      </div>
      <div class="demo-copy">
        <p class="eyebrow">Run it · see it · break it</p>
        <h2 id="demo-title">See the whole workflow.</h2>
        <p>From port collisions to clean endpoints, live topology, traffic inspection, recordings, and targeted faults.</p>
        <details class="transcript">
          <summary>Read the transcript</summary>
          <p>Local development gets messy fast. Projects compete for Postgres, Redis, and the same ports. Understanding what is happening means bouncing between terminals.</p>
          <p>Portless turns your environment into one control plane. Run Portless up. It starts processes and containers, then gives every application a clean localhost address.</p>
          <p>Watch traffic flow from checkout to orders, Postgres, and Redis. Open a request to inspect status, timing, headers, and response.</p>
          <p>Record a workflow, or introduce latency, errors, and aborted connections on one edge.</p>
          <p>One project. Multiple environments. Run it, see it, and break it—locally.</p>
        </details>
      </div>
    </section>

    <section class="final-cta" id="early-access" aria-labelledby="cta-title">
      <div class="final-cta__grid" aria-hidden="true"></div>
      <BrandMark />
      <h2 id="cta-title"><span>Run it.</span><span>See it.</span><span>Break it.</span></h2>
      <p>locally.</p>
      <a class="button" href={primaryCTA.href} target={primaryCTA.external ? '_blank' : undefined} rel={primaryCTA.external ? 'noreferrer' : undefined}>{primaryCTA.label}</a>
      {!primaryCTA.external && <small>Portless is preparing for its first public release.</small>}
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand-link" href="#top"><BrandMark compact /></a>
    <p>A local application-environment control plane.</p>
    <nav aria-label="Footer navigation">
      <a href="#how-it-works">Run it</a>
      <a href="#control-plane">See it</a>
      <a href="#experiments">Break it</a>
      <a href="#demo">Demo</a>
      {githubURL && <a href={githubURL} target="_blank" rel="noreferrer">GitHub</a>}
    </nav>
    <small>© {new Date().getFullYear()} Portless</small>
  </footer>

</SiteLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-traffic-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-traffic-panel]'));

  function selectTrafficTab(selected: HTMLButtonElement) {
    const selectedName = selected.dataset.trafficTab;
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.trafficPanel !== selectedName;
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTrafficTab(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const offset = event.key === 'ArrowRight' ? 1 : -1;
      const next = tabs[(index + offset + tabs.length) % tabs.length];
      if (!next) return;
      selectTrafficTab(next);
      next.focus();
    });
  });

  const demoVideo = document.querySelector<HTMLVideoElement>('[data-demo-video]');
  const demoPlayButton = document.querySelector<HTMLButtonElement>('[data-demo-play]');
  const demoProgress = document.querySelector<HTMLInputElement>('[data-demo-progress]');
  const demoTime = document.querySelector<HTMLOutputElement>('[data-demo-time]');
  const demoCaptionsButton = document.querySelector<HTMLButtonElement>('[data-demo-captions]');
  const demoMuteButton = document.querySelector<HTMLButtonElement>('[data-demo-mute]');
  const demoFullscreenButton = document.querySelector<HTMLButtonElement>('[data-demo-fullscreen]');

  const formatDemoTime = (seconds: number) => {
    if (!Number.isFinite(seconds)) return '0:00';
    const minutes = Math.floor(seconds / 60);
    return `${minutes}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
  };

  const syncDemoPlayback = () => {
    if (!demoVideo || !demoPlayButton) return;
    const isPlaying = !demoVideo.paused && !demoVideo.ended;
    demoPlayButton.textContent = isPlaying ? 'Ⅱ' : '▶';
    demoPlayButton.setAttribute('aria-label', isPlaying ? 'Pause demo' : 'Play demo');
  };

  const syncDemoTimeline = () => {
    if (!demoVideo) return;
    const duration = Number.isFinite(demoVideo.duration) ? demoVideo.duration : 0;
    if (demoProgress) demoProgress.value = duration > 0 ? String((demoVideo.currentTime / duration) * 100) : '0';
    if (demoTime) demoTime.textContent = `${formatDemoTime(demoVideo.currentTime)} / ${formatDemoTime(duration)}`;
  };

  const toggleDemoPlayback = async () => {
    if (!demoVideo) return;
    if (!demoVideo.paused && !demoVideo.ended) {
      demoVideo.pause();
      return;
    }
    await demoVideo.play();
  };

  const disableInitialCaptions = () => {
    if (!demoVideo) return;
    Array.from(demoVideo.textTracks).forEach((track) => {
      track.mode = 'disabled';
    });
  };

  disableInitialCaptions();
  demoVideo?.addEventListener('loadedmetadata', () => {
    disableInitialCaptions();
    syncDemoTimeline();
  }, {once: true});
  demoVideo?.addEventListener('play', syncDemoPlayback);
  demoVideo?.addEventListener('pause', syncDemoPlayback);
  demoVideo?.addEventListener('ended', syncDemoPlayback);
  demoVideo?.addEventListener('timeupdate', syncDemoTimeline);
  demoPlayButton?.addEventListener('click', () => void toggleDemoPlayback());
  demoProgress?.addEventListener('input', () => {
    if (!demoVideo || !Number.isFinite(demoVideo.duration)) return;
    demoVideo.currentTime = (Number(demoProgress.value) / 100) * demoVideo.duration;
  });
  demoCaptionsButton?.addEventListener('click', () => {
    if (!demoVideo) return;
    const tracks = Array.from(demoVideo.textTracks);
    const enabled = tracks.some((track) => track.mode === 'showing');
    tracks.forEach((track) => {
      track.mode = enabled ? 'disabled' : 'showing';
    });
    demoCaptionsButton.setAttribute('aria-pressed', String(!enabled));
    demoCaptionsButton.setAttribute('aria-label', enabled ? 'Turn captions on' : 'Turn captions off');
  });
  demoMuteButton?.addEventListener('click', () => {
    if (!demoVideo) return;
    demoVideo.muted = !demoVideo.muted;
    demoMuteButton.textContent = demoVideo.muted ? 'SOUND' : 'MUTE';
    demoMuteButton.setAttribute('aria-pressed', String(demoVideo.muted));
    demoMuteButton.setAttribute('aria-label', demoVideo.muted ? 'Unmute demo' : 'Mute demo');
  });
  demoFullscreenButton?.addEventListener('click', () => {
    if (!demoVideo) return;
    const webkitVideo = demoVideo as HTMLVideoElement & {webkitEnterFullscreen?: () => void};
    if (demoVideo.requestFullscreen) void demoVideo.requestFullscreen();
    else webkitVideo.webkitEnterFullscreen?.();
  });
  syncDemoPlayback();
  syncDemoTimeline();
</script>
